# Copy to .env (or export in your shell). All optional — Builder runs offline on Ollama out of the box.
# Builder's variables are BUILDER_*. The old SCHOLAR_* names still work as a fallback, but prefer BUILDER_*.

BUILDER_PROFILE=cpu                  # cpu (16GB Intel Mac, no GPU) · pi (Raspberry Pi 5) · gpu (Apple Silicon 32GB+ / desktop GPU)
BUILDER_MODEL=                       # the thinker: planning, review, security audits. Profile default: qwen2.5-coder:7b (cpu)
BUILDER_FAST_MODEL=                  # the reader: quick edits and explanations. Profile default: qwen2.5-coder:3b (cpu)
BUILDER_THINK=checks                 # thinker reasons step by step: checks = only the review/security pass (default) · all · off
BUILDER_NUM_CTX=                     # context window in tokens. Profile default: 8192 (cpu), 4096 (pi), 16384 (gpu)
BUILDER_READ_CHARS=                  # characters of each file the reader sees. Profile default: 6000 (cpu)
BUILDER_OLLAMA_URL=http://localhost:11434   # on a Pi, point this at a stronger machine to borrow its brain
BUILDER_LLM_TIMEOUT=900              # seconds per model call (CPU models are slow)
BUILDER_ONE_MODEL=1                  # keep one model in memory at a time (16GB Macs); 0 on 32GB+ machines

# Optional CLOUD BRAIN (the stronger model) — OFF by default. Set BOTH a model and a key to turn it on.
# When on, it becomes Builder's stronger brain for planning/self-review/escalation, and what it works out
# is distilled into local memory so the offline model learns from it. Needs: pip install 'builder[cloud]'.
BUILDER_CLOUD_MODEL=                  # e.g. a Claude model id (leave blank = cloud OFF, fully local)
BUILDER_CLOUD_API_KEY=               # your API key (also read from ANTHROPIC_API_KEY); only used if CLOUD_MODEL is set
BUILDER_CLOUD_BASE_URL=              # optional custom endpoint (leave blank for the default)
BUILDER_OFFLINE=0                    # 1 = never use the internet (he also notices on his own when it's down)
BUILDER_HOME=~/.builder              # builder.db + reports/ live here
BUILDER_NAME=Builder
BUILDER_USER=boss

# --- What Builder may touch (security scope — enforced in code) --------------------------------
BUILDER_CODE_DIRS=                   # the ONLY folders he may read/write, comma-separated, e.g. ~/Projects,~/code
                                     # empty = he can touch nothing until you set it. Never the whole disk.
BUILDER_LAB_MODE=0                   # authorized-lab mode. Leave 0. Turn on per target with: builder lab on <target> --i-own-this

BUILDER_EMBED_MODEL=nomic-embed-text # ollama pull nomic-embed-text — powers semantic memory (falls back to keyword search)
BUILDER_SANDBOX_TIMEOUT=60           # seconds a sandboxed snippet may run
BUILDER_API_HOST=127.0.0.1           # 0.0.0.0 to let the other family members reach him on your LAN
BUILDER_API_PORT=8767                # Amo uses 8765, Scholar 8766
BUILDER_API_TOKEN=                   # set this before exposing the API on your network
BUILDER_LAB_PASSWORD=                # set a password to turn offense/authorized-lab mode on/off from the dashboard (blank = terminal only)

# --- Family Hub (builder hub) ------------------------------------------------------------------
# Reach the hub through Amo's relay on this Mac (sidesteps the macOS Local-Network block).
HUB_URL=http://127.0.0.1:8771
HUB_TOKEN=                           # make it on the hub: python3 -m hub agent token builder
# Cloud brain: the family's Anthropic key. Also install the package once:
#   pip install 'builder[cloud]'    (needs Python 3.10+). With no package / no key / no hub
#   budget, Builder stays on the local coder model. Run `builder hub --check` to see if cloud is ready.
ANTHROPIC_API_KEY=
LOCAL_MODEL=qwen2.5-coder:7b         # shared Ollama model for the family (matches BUILDER_MODEL)
BUILDER_HUB_PROPOSE_HOURS=24         # how often Builder may suggest his own builds (0 = never)
BUILDER_HUB_TECHNICAL=technical-help # channel for build results + security findings
BUILDER_HUB_SECURITY=                # optional dedicated #security channel for review findings
