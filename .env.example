# Copy to .env (or export in your shell). All optional.
SCHOLAR_PROFILE=cpu                 # cpu (Intel Mac, no GPU) · pi (Raspberry Pi 5) · gpu (Apple Silicon 32GB+ / desktop GPU)
SCHOLAR_MODEL=                      # the thinker: planning, synthesis, the skeptic. Profile default: qwen3:8b (cpu)
SCHOLAR_FAST_MODEL=                 # the reader: pulls facts out of every source. Profile default: qwen3:4b-instruct (cpu)
SCHOLAR_THINK=checks                # thinker reasons step by step: checks = only the fact-check (default) · all · off
SCHOLAR_NUM_CTX=                    # context window in tokens. Profile default: 8192 (cpu), 4096 (pi), 16384 (gpu)
SCHOLAR_READ_CHARS=                 # characters of each source the reader sees. Profile default: 6000 (cpu)
SCHOLAR_OLLAMA_URL=http://localhost:11434   # on a Pi, point this at a stronger machine to borrow its brain
SCHOLAR_LLM_TIMEOUT=900             # seconds per model call
SCHOLAR_ONE_MODEL=1                 # keep one model in memory at a time (16GB Macs); 0 on 32GB+ machines
SCHOLAR_OFFLINE=0                   # 1 = never use the internet (he also notices on his own when it's down)
SCHOLAR_HOME=~/.scholar             # scholar.db + reports/ live here
SCHOLAR_NAME=Scholar
SCHOLAR_USER=boss
SCHOLAR_SEARXNG_URL=                # e.g. http://localhost:8888 — your own private metasearch (recommended)
SCHOLAR_TOR_PROXY=                  # e.g. 127.0.0.1:9050 — lets Scholar read .onion sources through Tor
SCHOLAR_OPENALEX_KEY=               # free key from https://openalex.org/settings/api (250M+ scholarly works)
SCHOLAR_CONTACT=                    # your email — SEC EDGAR requires it to search company filings
SCHOLAR_EMBED_MODEL=nomic-embed-text  # ollama pull nomic-embed-text — powers semantic memory
SCHOLAR_QDRANT_URL=                 # e.g. http://localhost:6333 — optional; without it vectors live in scholar.db
SCHOLAR_QDRANT_API_KEY=
SCHOLAR_SANDBOX_TIMEOUT=60          # seconds a Python analysis may run
SCHOLAR_API_HOST=127.0.0.1          # 0.0.0.0 to let the other family members reach him on your LAN
SCHOLAR_API_PORT=8766               # Amo uses 8765
SCHOLAR_API_TOKEN=                  # set this before exposing the API on your network

# --- Family Hub (scholar hub) ----------------------------------------------------------------
# Reach the hub through Amo's relay on this Mac (sidesteps the macOS Local-Network block);
# the relay forwards to the real hub at http://192.168.1.208:8770.
HUB_URL=http://127.0.0.1:8771
HUB_TOKEN=                          # make it on the hub: python3 -m hub agent token scholar
# Cloud brain (Part 2): the family's Anthropic key. Also install the package once:
#   pip install 'scholar[cloud]'   (needs Python 3.10+). With no package / no key / no hub
#   budget, Scholar stays on the local model. Run `scholar hub --check` to see if cloud is ready.
ANTHROPIC_API_KEY=
LOCAL_MODEL=qwen3:8b                # shared Ollama model for the family (matches SCHOLAR_MODEL)
SCHOLAR_HUB_PROPOSE_HOURS=24        # how often Scholar may suggest his own research (0 = never)
